a est&aacute; dividida nas sess&otilde;es abaixo: </p><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" data-layout=\"default\" ac:local-id=\"ea77938a-44eb-4e6f-a855-f8d9614d9d87\" ac:macro-id=\"50ea35e3-0b20-4d6a-b3f7-0534c13da4eb\" />","representation":"storage","embeddedContent":[],"_expandable":{"content":"/rest/api/content/86835214"}},"_expandable":{"editor":"","atlas_doc_format":"","view":"","export_view":"","styled_view":"","markdown":"","dynamic":"","editor2":"","anonymous_export_view":""}},"extensions":{"position":364958463},"_expandable":{"container":"/rest/api/space/OF","metadata":"","restrictions":"/rest/api/content/86835214/restriction/byOperation","history":"/rest/api/content/86835214/history","descendants":"/rest/api/content/86835214/descendant","space":"/rest/api/space/OF","childTypes":"","schedulePublishInfo":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/86835214/child","ancestors":"","draftVersion":""},"_links":{"editui":"/pages/resumedraft.action?draftId=86835214","webui":"/spaces/OF/pages/86835214/Pol+tica+de+Versionamento","edituiv2":"/spaces/OF/pages/edit-v2/86835214","context":"/wiki","self":"https://openfinancebrasil.atlassian.net/wiki/rest/api/content/86835214","tinyui":"/x/DgAtBQ","collection":"/rest/api/content","base":"https://openfinancebrasil.atlassian.net/wiki"}}